# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่า (บน Windows: copy .env.example .env)
PORT=3000
# รหัสเข้าหน้าครู — ตั้งให้ยาวและเดายาก อย่างน้อย 8 ตัวอักษร
ADMIN_CODE=teacher1234
# ใส่คีย์เพื่อใช้ AI จริง ถ้าไม่ใส่ ระบบจะใช้โหมดจำลอง (ห้ามใช้โหมดจำลองกับรางวัลจริง)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# URL ที่นักเรียนเปิดเข้ามา (ใช้ใน QR Code ของใบประกาศ) เช่น https://greencampus.example.ac.th
PUBLIC_URL=http://localhost:3000
# ความมั่นใจขั้นต่ำที่ AI จะตัดสินเอง (0-1) ยิ่งสูงยิ่งส่งครูมาก ปรับหลังรัน node tools/eval-ai.js
AI_PASS=0.8
# เพดานจำนวนรูปที่ส่งให้ AI ต่อวัน (คุมค่าใช้จ่าย) เกินแล้วรูปจะไปรอครูตรวจ
AI_DAILY_LIMIT=500
# เก็บรูปหลักฐานกี่วัน แล้วลบอัตโนมัติ
IMAGE_KEEP_DAYS=30
# ตั้งเป็น production เมื่อใช้งานจริง (ระบบจะไม่ยอมเริ่มถ้ายังใช้ ADMIN_CODE เริ่มต้น)
NODE_ENV=
